<Window x:Class="CardAdjust.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardAdjust"
        xmlns:styles="clr-namespace:CardAdjust.Styles"
        xmlns:resx="clr-namespace:CardAdjust.Resources"
        xmlns:conv="clr-namespace:CardAdjust.Converters"
        xmlns:behaviors="clr-namespace:CardAdjust.Behaviors"
        xmlns:models="clr-namespace:CardAdjust.Models"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:RegionOverrideBrushConverter x:Key="RegionOverrideBrushConverter" />
    </Window.Resources>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}"
          Background="Transparent"
          behaviors:ClearFocusOnClickBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 一斉出力。カード一覧の全カードを、指定フォルダへPNGとして一斉に出力する。 -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                   Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <Button DockPanel.Dock="Right" Content="{x:Static resx:Strings.Button_BatchExport}"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                    Command="{Binding BatchExportCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{x:Static resx:Strings.Label_BatchExportFolder}"
                       VerticalAlignment="Center" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <TextBox Text="{Binding BatchExportFolder}" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- カード一覧。フォルダ内の画像を選択してプレビュー対象を切り替える。 -->
        <DockPanel Grid.Row="1" Grid.Column="0" Width="{x:Static styles:LayoutConstants.CardListWidth}"
                   Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_CardList}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <ListBox ItemsSource="{Binding CardList}" SelectedItem="{Binding SelectedCard}"
                     DisplayMemberPath="DisplayName" />
        </DockPanel>

        <!-- 元画像。選択中カードの生画像に、②③④の読取矩形をドラッグ可能な状態で重ねて表示する。 -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_SourceImage}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <Viewbox Stretch="Uniform">
                <Grid Width="{x:Static models:CardTemplateLayout.TemplateWidth}"
                      Height="{x:Static models:CardTemplateLayout.TemplateHeight}">
                    <Image Source="{Binding SourceImage}" Stretch="Fill" />
                    <Canvas>
                        <!-- ドラッグで位置を、右下端のハンドルで幅・高さを個別に調整できる。 -->
                        <!-- 枠色は全体設定(青)/個別設定(黄)を示す。個別設定になるまで塗りつぶしは不要なためTransparent(ヒットテストのため必須)。 -->
                        <Border Canvas.Left="{Binding TitleRegionX}" Canvas.Top="{Binding TitleRegionY}"
                                Width="{Binding TitleRegionWidth}" Height="{Binding TitleRegionHeight}"
                                BorderBrush="{Binding IsTitleRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <TextBlock Text="{x:Static resx:Strings.Label_Title}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsTitleRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />
                                <Rectangle Width="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           Height="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding IsTitleRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Cursor="SizeNWSE" behaviors:ResizeHandleBehavior.IsEnabled="True" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding IllustrationRegionX}" Canvas.Top="{Binding IllustrationRegionY}"
                                Width="{Binding IllustrationRegionWidth}" Height="{Binding IllustrationRegionHeight}"
                                BorderBrush="{Binding IsIllustrationRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <TextBlock Text="{x:Static resx:Strings.Label_Illustration}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsIllustrationRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />
                                <Rectangle Width="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           Height="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding IsIllustrationRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Cursor="SizeNWSE" behaviors:ResizeHandleBehavior.IsEnabled="True" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding DescriptionRegionX}" Canvas.Top="{Binding DescriptionRegionY}"
                                Width="{Binding DescriptionRegionWidth}" Height="{Binding DescriptionRegionHeight}"
                                BorderBrush="{Binding IsDescriptionRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <TextBlock Text="{x:Static resx:Strings.Label_Description}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsDescriptionRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />
                                <Rectangle Width="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           Height="{x:Static styles:LayoutConstants.RegionResizeHandleSize}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding IsDescriptionRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Cursor="SizeNWSE" behaviors:ResizeHandleBehavior.IsEnabled="True" />
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>
            </Viewbox>
        </DockPanel>

        <!-- プレビュー。①外枠～④説明文を合成した完成イメージを表示する。 -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_Preview}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <CheckBox DockPanel.Dock="Top" Content="{x:Static resx:Strings.Label_HighlightOverrides}"
                      IsChecked="{Binding HighlightOverridesEnabled}"
                      Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <Button DockPanel.Dock="Bottom" Content="{x:Static resx:Strings.Button_Save}"
                    HorizontalAlignment="Right" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                    Command="{Binding SaveImageCommand}" />
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
        </DockPanel>

        <!-- 要素操作。②③④それぞれの読取・調整ボタンとテキストボックスを並べる。 -->
        <StackPanel Grid.Row="1" Grid.Column="3" Width="{x:Static styles:LayoutConstants.ElementPanelWidth}"
                    Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Title}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                         behaviors:TextBoxSelectionBehavior.IsEnabled="True"
                         behaviors:TextBoxSelectionBehavior.SelectionStart="{Binding TitleSelectionStart}"
                         behaviors:TextBoxSelectionBehavior.SelectionLength="{Binding TitleSelectionLength}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadTitleCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AdjustTitleCommand}" />
                </StackPanel>
                <!-- 個別設定一覧。プレビュー上の番号付き矩形と同じ番号で対応する。 -->
                <ItemsControl ItemsSource="{Binding TitleOverrideSummaries}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
                                <Button Content="{x:Static resx:Strings.Button_Adjust}"
                                        Command="{Binding DataContext.AdjustTitleOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Illustration}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <StackPanel Orientation="Horizontal" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <RadioButton GroupName="IllustrationAspectRatio" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                 Content="{x:Static resx:Strings.RadioButton_KeepAspectRatio}"
                                 IsChecked="{Binding KeepIllustrationAspectRatio}" />
                    <RadioButton GroupName="IllustrationAspectRatio" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                 Content="{x:Static resx:Strings.RadioButton_DontKeepAspectRatio}"
                                 IsChecked="{Binding KeepIllustrationAspectRatio, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadIllustrationCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Description}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <TextBox Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="{x:Static styles:LayoutConstants.DescriptionTextBoxHeight}"
                         behaviors:TextBoxSelectionBehavior.IsEnabled="True"
                         behaviors:TextBoxSelectionBehavior.SelectionStart="{Binding DescriptionSelectionStart}"
                         behaviors:TextBoxSelectionBehavior.SelectionLength="{Binding DescriptionSelectionLength}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadDescriptionCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AdjustDescriptionCommand}" />
                </StackPanel>
                <!-- 個別設定一覧。プレビュー上の番号付き矩形と同じ番号で対応する。 -->
                <ItemsControl ItemsSource="{Binding DescriptionOverrideSummaries}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
                                <Button Content="{x:Static resx:Strings.Button_Adjust}"
                                        Command="{Binding DataContext.AdjustDescriptionOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
