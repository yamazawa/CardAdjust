<Window x:Class="CardAdjust.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CardAdjust"
        xmlns:styles="clr-namespace:CardAdjust.Styles"
        xmlns:resx="clr-namespace:CardAdjust.Resources"
        xmlns:conv="clr-namespace:CardAdjust.Converters"
        xmlns:behaviors="clr-namespace:CardAdjust.Behaviors"
        xmlns:models="clr-namespace:CardAdjust.Models"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.WindowTitle}"
        Height="{Binding WindowHeight, Mode=TwoWay}"
        Width="{Binding WindowWidth, Mode=TwoWay}"
        MinHeight="{x:Static styles:LayoutConstants.WindowMinHeight}"
        MinWidth="{x:Static styles:LayoutConstants.WindowMinWidth}">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:RegionOverrideBrushConverter x:Key="RegionOverrideBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="{x:Static styles:LayoutConstants.RootMargin}"
          Background="Transparent"
          behaviors:ClearFocusOnClickBehavior.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 一斉出力。カード一覧の全カードを、指定フォルダへPNGとして一斉に出力する。 -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                   Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <Button DockPanel.Dock="Right" Content="{x:Static resx:Strings.Button_BatchExport}"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                    Command="{Binding BatchExportCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="{x:Static resx:Strings.Label_BatchExportFolder}"
                       VerticalAlignment="Center" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <TextBox Text="{Binding BatchExportFolder}" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- カード一覧。フォルダ内の画像を選択してプレビュー対象を切り替える。 -->
        <DockPanel Grid.Row="1" Grid.Column="0" Width="{x:Static styles:LayoutConstants.CardListWidth}"
                   Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_CardList}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <ListBox ItemsSource="{Binding CardList}" SelectedItem="{Binding SelectedCard}"
                     DisplayMemberPath="DisplayName" />
        </DockPanel>

        <!-- 元画像。選択中カードの生画像に、②③④の読取矩形をドラッグ可能な状態で重ねて表示する。 -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_SourceImage}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <Viewbox Stretch="Uniform">
                <Grid Width="{x:Static models:CardTemplateLayout.TemplateWidth}"
                      Height="{x:Static models:CardTemplateLayout.TemplateHeight}">
                    <Image Source="{Binding SourceImage}" Stretch="Fill" />
                    <Canvas>
                        <!-- ドラッグで位置を、右下端のハンドルで幅・高さを個別に調整できる。 -->
                        <!-- 枠色は全体設定(青)/個別設定(黄)を示す。個別設定になるまで塗りつぶしは不要なためTransparent(ヒットテストのため必須)。 -->
                        <Border Canvas.Left="{Binding TitleRegionX, Mode=TwoWay}" Canvas.Top="{Binding TitleRegionY, Mode=TwoWay}"
                                Width="{Binding TitleRegionWidth, Mode=TwoWay}" Height="{Binding TitleRegionHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsTitleRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Title}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsTitleRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <!-- 4隅・4辺のドラッグ可能なリサイズ領域。表示なし(Transparent)、元矩形より5px広くはみ出す。 -->
                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding IllustrationRegionX, Mode=TwoWay}" Canvas.Top="{Binding IllustrationRegionY, Mode=TwoWay}"
                                Width="{Binding IllustrationRegionWidth, Mode=TwoWay}" Height="{Binding IllustrationRegionHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsIllustrationRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Illustration}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsIllustrationRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding DescriptionRegionX, Mode=TwoWay}" Canvas.Top="{Binding DescriptionRegionY, Mode=TwoWay}"
                                Width="{Binding DescriptionRegionWidth, Mode=TwoWay}" Height="{Binding DescriptionRegionHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsDescriptionRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Description}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsDescriptionRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>
                    </Canvas>
                </Grid>
            </Viewbox>
        </DockPanel>

        <!-- プレビュー。①外枠～④説明文を合成した完成イメージを表示する。 -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static resx:Strings.Header_Preview}"
                       FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <CheckBox DockPanel.Dock="Top" Content="{x:Static resx:Strings.Label_ShowGuide}"
                      IsChecked="{Binding ShowGuide}"
                      Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <Button DockPanel.Dock="Bottom" Content="{x:Static resx:Strings.Button_Save}"
                    HorizontalAlignment="Right" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                    Command="{Binding SaveImageCommand}" />
            <Viewbox Stretch="Uniform">
                <Grid Width="{x:Static models:CardTemplateLayout.TemplateWidth}"
                      Height="{x:Static models:CardTemplateLayout.TemplateHeight}">
                    <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                    <Canvas>
                        <!-- ①～④の貼付先矩形。元画像側の読取矩形と同様に、全体設定(青)/個別設定(黄)・ドラッグ移動・8方向リサイズに対応する。 -->
                        <Border Canvas.Left="{Binding TitleDestX, Mode=TwoWay}" Canvas.Top="{Binding TitleDestY, Mode=TwoWay}"
                                Width="{Binding TitleDestWidth, Mode=TwoWay}" Height="{Binding TitleDestHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsTitleDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                Visibility="{Binding ShowGuide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Title}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsTitleDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding IllustrationDestX, Mode=TwoWay}" Canvas.Top="{Binding IllustrationDestY, Mode=TwoWay}"
                                Width="{Binding IllustrationDestWidth, Mode=TwoWay}" Height="{Binding IllustrationDestHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsIllustrationDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                Visibility="{Binding ShowGuide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Illustration}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsIllustrationDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>
                        <Border Canvas.Left="{Binding DescriptionDestX, Mode=TwoWay}" Canvas.Top="{Binding DescriptionDestY, Mode=TwoWay}"
                                Width="{Binding DescriptionDestWidth, Mode=TwoWay}" Height="{Binding DescriptionDestHeight, Mode=TwoWay}"
                                BorderBrush="{Binding IsDescriptionDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                Visibility="{Binding ShowGuide, Converter={StaticResource BooleanToVisibilityConverter}}"
                                BorderThickness="3" Background="Transparent" Cursor="SizeAll"
                                behaviors:DragMoveBehavior.IsEnabled="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{x:Static styles:LayoutConstants.RegionResizeHandleGridLength}" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.RowSpan="3" Grid.ColumnSpan="3" Text="{x:Static resx:Strings.Label_Description}" IsHitTestVisible="False"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="{x:Static styles:LayoutConstants.RegionLabelFontSize}"
                                           Foreground="{Binding IsDescriptionDestRegionIndividual, Converter={StaticResource RegionOverrideBrushConverter}}"
                                           Background="#AA000000" Padding="2,0" />

                                <Rectangle Grid.Row="0" Grid.Column="0" Margin="-5,-5,0,0" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="TopLeft" />
                                <Rectangle Grid.Row="0" Grid.Column="1" Margin="0,-5,0,0" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Top" />
                                <Rectangle Grid.Row="0" Grid.Column="2" Margin="0,-5,-5,0" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="TopRight" />
                                <Rectangle Grid.Row="1" Grid.Column="0" Margin="-5,0,0,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Left" />
                                <Rectangle Grid.Row="1" Grid.Column="2" Margin="0,0,-5,0" Fill="Transparent" Cursor="SizeWE"
                                           behaviors:ResizeHandleBehavior.Direction="Right" />
                                <Rectangle Grid.Row="2" Grid.Column="0" Margin="-5,0,0,-5" Fill="Transparent" Cursor="SizeNESW"
                                           behaviors:ResizeHandleBehavior.Direction="BottomLeft" />
                                <Rectangle Grid.Row="2" Grid.Column="1" Margin="0,0,0,-5" Fill="Transparent" Cursor="SizeNS"
                                           behaviors:ResizeHandleBehavior.Direction="Bottom" />
                                <Rectangle Grid.Row="2" Grid.Column="2" Margin="0,0,-5,-5" Fill="Transparent" Cursor="SizeNWSE"
                                           behaviors:ResizeHandleBehavior.Direction="BottomRight" />
                            </Grid>
                        </Border>

                        <!-- 個別設定の番号付き矩形。クリックすると調整ダイアログを開く。矩形表示より手前(後に描画)に重ねる。 -->
                        <ItemsControl ItemsSource="{Binding TitleAnnotations}"
                                      Visibility="{Binding ShowGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Number}" Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            FontSize="{x:Static styles:LayoutConstants.AnnotationNumberFontSize}" FontWeight="Bold"
                                            Foreground="Yellow" Background="Transparent" BorderBrush="Yellow" BorderThickness="1.5"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.AdjustTitleOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Override}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DescriptionAnnotations}"
                                      Visibility="{Binding ShowGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Number}" Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            FontSize="{x:Static styles:LayoutConstants.AnnotationNumberFontSize}" FontWeight="Bold"
                                            Foreground="Yellow" Background="Transparent" BorderBrush="Yellow" BorderThickness="1.5"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.AdjustDescriptionOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Override}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Grid>
            </Viewbox>
        </DockPanel>

        <!-- 要素操作。②③④それぞれの読取・調整ボタンとテキストボックスを並べる。 -->
        <StackPanel Grid.Row="1" Grid.Column="3" Width="{x:Static styles:LayoutConstants.ElementPanelWidth}"
                    Margin="{x:Static styles:LayoutConstants.SectionSpacing}">
            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Title}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <TextBox Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                         behaviors:TextBoxSelectionBehavior.IsEnabled="True"
                         behaviors:TextBoxSelectionBehavior.SelectionStart="{Binding TitleSelectionStart}"
                         behaviors:TextBoxSelectionBehavior.SelectionLength="{Binding TitleSelectionLength}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadTitleCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AdjustTitleCommand}" />
                </StackPanel>
                <!-- 個別設定一覧。プレビュー上の番号付き矩形と同じ番号で対応する。 -->
                <ItemsControl ItemsSource="{Binding TitleOverrideSummaries}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
                                <Button Content="{x:Static resx:Strings.Button_Adjust}"
                                        Command="{Binding DataContext.AdjustTitleOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Override}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Illustration}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <StackPanel Orientation="Horizontal" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <RadioButton GroupName="IllustrationAspectRatio" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                 Content="{x:Static resx:Strings.RadioButton_KeepAspectRatio}"
                                 IsChecked="{Binding KeepIllustrationAspectRatio}" />
                    <RadioButton GroupName="IllustrationAspectRatio" Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                                 Content="{x:Static resx:Strings.RadioButton_DontKeepAspectRatio}"
                                 IsChecked="{Binding KeepIllustrationAspectRatio, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadIllustrationCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
                <TextBlock Text="{x:Static resx:Strings.Label_Description}"
                           FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
                <TextBox Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="{x:Static styles:LayoutConstants.FieldSpacing}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="{x:Static styles:LayoutConstants.DescriptionTextBoxHeight}"
                         behaviors:TextBoxSelectionBehavior.IsEnabled="True"
                         behaviors:TextBoxSelectionBehavior.SelectionStart="{Binding DescriptionSelectionStart}"
                         behaviors:TextBoxSelectionBehavior.SelectionLength="{Binding DescriptionSelectionLength}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{x:Static resx:Strings.Button_Read}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding ReadDescriptionCommand}" />
                    <Button Content="{x:Static resx:Strings.Button_Adjust}"
                            Margin="{x:Static styles:LayoutConstants.ButtonSpacing}"
                            Command="{Binding AdjustDescriptionCommand}" />
                </StackPanel>
                <!-- 個別設定一覧。プレビュー上の番号付き矩形と同じ番号で対応する。 -->
                <ItemsControl ItemsSource="{Binding DescriptionOverrideSummaries}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
                                <Button Content="{x:Static resx:Strings.Button_Adjust}"
                                        Command="{Binding DataContext.AdjustDescriptionOverrideCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Override}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
