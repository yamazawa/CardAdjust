<Window x:Class="CardAdjust.Views.AdjustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:CardAdjust.Resources"
        xmlns:styles="clr-namespace:CardAdjust.Styles"
        Title="{x:Static resx:Strings.AdjustDialog_Title}"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <StackPanel Margin="{x:Static styles:LayoutConstants.RootMargin}">
        <TextBlock Text="{x:Static resx:Strings.Label_FontFamily}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding FontFamilyName}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <TextBlock Text="{x:Static resx:Strings.Label_FontSize}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding FontSize}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <TextBlock Text="{x:Static resx:Strings.Label_LetterSpacing}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding LetterSpacing}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <StackPanel Visibility="{Binding ShowLineSpacing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{x:Static resx:Strings.Label_LineSpacing}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
            <TextBox Text="{Binding LineSpacing}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
            <Button Content="{x:Static resx:Strings.Button_Clear}" Command="{Binding ClearCommand}"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Button Content="{x:Static resx:Strings.Button_Cancel}" Command="{Binding CancelCommand}" IsCancel="True"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Button Content="{x:Static resx:Strings.Button_Ok}" Command="{Binding OkCommand}" IsDefault="True"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
        </StackPanel>
    </StackPanel>
</Window>
