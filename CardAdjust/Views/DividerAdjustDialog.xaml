<Window x:Class="CardAdjust.Views.DividerAdjustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:CardAdjust.Resources"
        xmlns:styles="clr-namespace:CardAdjust.Styles"
        xmlns:behaviors="clr-namespace:CardAdjust.Behaviors"
        Title="{x:Static resx:Strings.AdjustDialog_Title}"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <StackPanel Margin="{x:Static styles:LayoutConstants.RootMargin}"
                Background="Transparent"
                behaviors:ClearFocusOnClickBehavior.IsEnabled="True">
        <TextBlock Text="{x:Static resx:Strings.Label_Divider}" FontWeight="Bold" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <TextBlock Text="{x:Static resx:Strings.Label_DividerThickness}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding Thickness}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <TextBlock Text="{x:Static resx:Strings.Label_DividerMarginTop}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding MarginTop}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <TextBlock Text="{x:Static resx:Strings.Label_DividerMarginBottom}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />
        <TextBox Text="{Binding MarginBottom}" Margin="{x:Static styles:LayoutConstants.FieldSpacing}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{x:Static styles:LayoutConstants.ElementSpacing}">
            <Button Content="{x:Static resx:Strings.Button_Clear}" Command="{Binding ClearCommand}"
                    Visibility="{Binding ShowClearButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Button Content="{x:Static resx:Strings.Button_Cancel}" Command="{Binding CancelCommand}" IsCancel="True"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
            <Button Content="{x:Static resx:Strings.Button_Ok}" Command="{Binding OkCommand}" IsDefault="True"
                    Margin="{x:Static styles:LayoutConstants.ButtonSpacing}" />
        </StackPanel>
    </StackPanel>
</Window>
